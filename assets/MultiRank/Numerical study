# 시각화 데이터 준비
plot_data_main <- all_results %>%
  filter(K != 12) %>% 
  pivot_longer(cols = c("HOMALS", "GRM", "VAMOS"), names_to = "Method", values_to = "Tau") %>%
  mutate(Method = factor(Method, levels = c("HOMALS", "GRM", "VAMOS")), K_factor = factor(K)) %>%
  filter(!is.na(Tau))

# [시각화 1] Comparative Performance Trajectories (HetType 분리 적용)
p_trend <- ggplot(plot_data_main, aes(x = K_factor, y = Tau, color = Method)) +
  geom_line(aes(group = interaction(Method, Sim)), position = position_dodge(width = 0.4), alpha = 0.1, linewidth = 0.3) +
  stat_summary(aes(group = Method), fun.data = mean_sdl, fun.args = list(mult = 1), geom = "errorbar", width = 0.2, position = position_dodge(width = 0.4), linewidth = 0.7) +
  stat_summary(aes(group = Method), fun = mean, geom = "line", position = position_dodge(width = 0.4), linewidth = 1.2) +
  stat_summary(aes(group = Method), fun = mean, geom = "point", position = position_dodge(width = 0.4), size = 2, shape = 21, fill = "white", stroke = 1.2) +
  facet_grid(n ~ rho + HetType, labeller = label_both) + # Grid에 신규 조건 반영
  scale_color_brewer(palette = "Set1") +
  theme_bw(base_size = 12) +
  labs(title = "Comparative Performance Trajectories", x = "K", y = "Kendall's Tau", color = "Method") +
  theme(legend.position = "bottom", strip.background = element_rect(fill = "grey95"))

print(p_trend)

# [시각화 2] Sparsity Analysis
empty_cells_summary <- all_results %>%
  group_by(n, K, rho, HetType) %>%
  summarize(Avg_Empty = mean(EmptyCells), Total_Cells = first(K)^2, .groups = "drop") %>%
  mutate(n_label = factor(paste0("Sample Size (n) = ", n)), rho_factor = factor(rho))

p_empty <- ggplot(empty_cells_summary, aes(x = K, y = Avg_Empty)) +
  geom_line(aes(y = Total_Cells), color = "grey60", linetype = "dashed", linewidth = 0.8) +
  geom_line(aes(color = rho_factor), linewidth = 1) +
  geom_point(aes(color = rho_factor), size = 3) +
  facet_grid(HetType ~ n_label) + # HetType 별로 행 분할
  scale_x_continuous(breaks = unique(empty_cells_summary$K)) +
  scale_color_viridis_d(option = "plasma") +
  theme_bw(base_size = 14) +
  labs(title = "Average Number of Empty Cells by K, n, and rho", x = "K", y = "Average Empty Cells", color = "rho") +
  theme(legend.position = "bottom", strip.background = element_rect(fill = "grey90"))

print(p_empty)

# [시각화 3] Top-20 Elite Recovery
if(nrow(top20_df) > 0) {
  plot_data_top20 <- top20_df %>% pivot_longer(cols = c("HOMALS", "GRM", "VAMOS"), names_to = "Method", values_to = "Recovered_mu") %>% mutate(Method = factor(Method, levels = c("HOMALS", "GRM", "VAMOS")))
  ideal_df <- data.frame(Estimated_Rank = 1:20, Ideal_mu = sort(fixed_mu_top20, decreasing = TRUE)[1:20])
  
  p_top20 <- ggplot(plot_data_top20, aes(x = Estimated_Rank, y = Recovered_mu, color = Method)) +
    geom_point(data = ideal_df, aes(x = Estimated_Rank, y = Ideal_mu), inherit.aes = FALSE, color = "black", shape = 4, size = 4.5, stroke = 1.5) +
    stat_summary(aes(group = Method), fun.data = mean_sdl, fun.args = list(mult = 1), geom = "errorbar", width = 0.5, position = position_dodge(width = 0.6), linewidth = 0.8) +
    stat_summary(aes(group = Method), fun = mean, geom = "line", position = position_dodge(width = 0.6), linewidth = 1.2) +
    stat_summary(aes(group = Method), fun = mean, geom = "point", position = position_dodge(width = 0.6), size = 3, shape = 21, fill = "white", stroke = 1.5) +
    scale_x_continuous(breaks = 1:20) + scale_color_brewer(palette = "Set1") +
    theme_bw(base_size = 14) +
    labs(title = "Top-20 Elite Recovery", x = "Estimated Rank", y = "True mu Value") +
    theme(legend.position = "bottom")
  
  print(p_top20)
}



