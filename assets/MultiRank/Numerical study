# ==============================================================================
# 1. 데이터 생성 (Data Generation)
# ==============================================================================
generate_data <- function(n, rho, K, gamma, het_type, fixed_mu = NULL) {
  
  if (is.null(fixed_mu)) {
    mu <- rnorm(n, 0, 1)
  } else {
    mu <- fixed_mu
  }
  
  Sigma_base <- matrix(c(1, rho, rho, 1), 2, 2)
  base_eps <- mvrnorm(n, mu = c(0, 0), Sigma = Sigma_base)
  
  # 이분산성 2가지 조건 반영
  sigma_X <- 0.5
  if (het_type == "exp_mu") {
    sigma_Y <- 0.5 * exp(mu)                   
  } else if (het_type == "gamma_scale") {
    sigma_Y <- sigma_X * sqrt(gamma)           
  }
  
  epsilon_X <- sigma_X * base_eps[, 1]
  epsilon_Y <- sigma_Y * base_eps[, 2]
  
  Y_cont <- cbind(mu + epsilon_X, mu + epsilon_Y)
  
  cut_X <- quantile(Y_cont[, 1], probs = seq(0, 1, length.out = K + 1))
  cut_Y <- quantile(Y_cont[, 2], probs = seq(0, 1, length.out = K + 1))
  cut_X[c(1, K + 1)] <- c(-Inf, Inf)
  cut_Y[c(1, K + 1)] <- c(-Inf, Inf)
  
  raw_data <- data.frame(
    X = ordered(as.numeric(cut(Y_cont[, 1], cut_X)), levels = 1:K),
    Y = ordered(as.numeric(cut(Y_cont[, 2], cut_Y)), levels = 1:K)
  )
  
  final_counts <- as.vector(t(table(raw_data$X, raw_data$Y)))
  empty_cells_count <- sum(final_counts == 0)
  
  return(list(raw_data = raw_data, final_counts = final_counts, empty_cells = empty_cells_count, mu = mu))
}

# ==============================================================================
# 2. 모델 적합 (Model Fitting)
# ==============================================================================
fit_models <- function(raw_data, final_counts, n, K, mu) {
  
  tau_homals <- NA; tau_grm <- NA; tau_vamos <- NA
  scores_homals <- rep(NA, n); scores_grm <- rep(NA, n); scores_vamos <- rep(NA, n)
  
  # [1] HOMALS
  try({
    G1 <- model.matrix(~ X - 1, data = raw_data); G2 <- model.matrix(~ Y - 1, data = raw_data)
    A <- matrix(0, K - 1, K); for (i in 1:(K - 1)) { A[i, i] <- 1; A[i, i+1] <- -1 }
    Dmat1 <- t(G1) %*% G1 + diag(1e-8, K); Dmat2 <- t(G2) %*% G2 + diag(1e-8, K)
    y1 <- 1:K; y2 <- 1:K
    for (iter in 1:50) {
      obj <- scale(G1 %*% y1 + G2 %*% y2) * sqrt(n)
      y1_new <- solve.QP(Dmat1, as.vector(t(G1) %*% obj), t(-A), rep(1e-4, K - 1))$solution
      y2_new <- solve.QP(Dmat2, as.vector(t(G2) %*% obj), t(-A), rep(1e-4, K - 1))$solution
      if (max(abs(y1 - y1_new)) < 1e-5) break
      y1 <- y1_new; y2 <- y2_new
    }
    scores_homals <- as.vector(G1 %*% y1 + G2 %*% y2)
    tau_homals <- cor(mu, scores_homals, method = "kendall", use = "complete.obs")
  }, silent = TRUE)
  
  # [2] GRM
  try({
    suppressWarnings({
      g_mod <- grm(data.frame(lapply(raw_data, as.numeric)), constrained = FALSE)
      f_res <- factor.scores(g_mod, resp.patterns = expand.grid(X = 1:K, Y = 1:K))
      scores_mat <- matrix(NA, K, K)
      for (r in 1:nrow(f_res$score.dat)) { scores_mat[f_res$score.dat$X[r], f_res$score.dat$Y[r]] <- f_res$score.dat$z1[r] }
      scores_grm <- scores_mat[cbind(as.numeric(raw_data$X), as.numeric(raw_data$Y))]
      tau_grm <- cor(mu, scores_grm, method = "kendall", use = "complete.obs")
    })
  }, silent = TRUE)
  
  # [3] VAMOS
  try({
    num_c <- 2 * K * (K - 1); A_vamos <- matrix(0, num_c, K^2); r_idx <- 1
    for (i in 1:K) for (j in 1:(K - 1)) { A_vamos[r_idx, (i - 1) * K + j] <- 1; A_vamos[r_idx, (i - 1) * K + j+1] <- -1; r_idx <- r_idx + 1 }
    for (i in 1:(K - 1)) for (j in 1:K) { A_vamos[r_idx, (i - 1) * K + j] <- 1; A_vamos[r_idx, i * K + j] <- -1; r_idx <- r_idx + 1 }
    fn <- function(s) { ms <- sum(final_counts * s) / n; -(sum(final_counts * s^2) / n - ms^2) }
    gr <- function(s) { ms <- sum(final_counts * s) / n; -((2 / n) * final_counts * s - 2 * ms * (final_counts / n)) }
    res_v <- nloptr(x0 = seq(0, 1, length.out = K^2), eval_f = fn, eval_grad_f = gr,
                    eval_g_ineq = function(s) as.vector(A_vamos %*% s + 1e-4), eval_jac_g_ineq = function(s) A_vamos,
                    lb = rep(0, K^2), ub = rep(1, K^2), opts = list(algorithm = "NLOPT_LD_SLSQP", xtol_rel = 1e-4, maxeval = 500))
    s_vamos_mat <- matrix(res_v$solution, K, K, byrow = TRUE)
    scores_vamos <- s_vamos_mat[cbind(as.numeric(raw_data$X), as.numeric(raw_data$Y))]
    tau_vamos <- cor(mu, scores_vamos, method = "kendall", use = "complete.obs")
  }, silent = TRUE)
  
  return(list(taus = c(HOMALS = tau_homals, GRM = tau_grm, VAMOS = tau_vamos),
              scores = list(HOMALS = scores_homals, GRM = scores_grm, VAMOS = scores_vamos)))
}


# ==============================================================================
# 3. 대규모 시뮬레이션 세팅 & 실행
# ==============================================================================
grid_params <- expand.grid(
  n        = c(300, 1000, 3000),
  rho      = c(-0.7, -0.3, 0, 0.3, 0.7),
  K        = c(3, 5, 7, 10, 12),
  gamma    = 3, 
  het_type = c("exp_mu", "gamma_scale") 
)

n_sim <- 50
total_cond <- nrow(grid_params)

results_list <- list()
top20_results_list <- list()

cat(sprintf("🔥 대규모 시뮬레이션 시작 (총 %d개 조건, 조건당 %d회 반복)\n", total_cond, n_sim))
set.seed(2026)

for (idx in 1:total_cond) {
  p_n <- grid_params$n[idx]; p_rho <- grid_params$rho[idx]
  p_K <- grid_params$K[idx]; p_gamma <- grid_params$gamma[idx]
  p_het <- grid_params$het_type[idx]
  
  cat(sprintf("\n[조건 %d/%d] n=%d, rho=%.1f, K=%d, Type=%s...", idx, total_cond, p_n, p_rho, p_K, p_het))
  
  is_top20_cond <- (p_n == 1000 && p_K == 7 && p_rho == 0 && p_het == "exp_mu")
  if(is_top20_cond) fixed_mu_top20 <- rnorm(p_n, 0, 1)
  
  for (sim in 1:n_sim) {
    d_out <- generate_data(p_n, p_rho, p_K, p_gamma, p_het, if(is_top20_cond) fixed_mu_top20 else NULL)
    m_out <- fit_models(d_out$raw_data, d_out$final_counts, p_n, p_K, d_out$mu)
    
    results_list[[length(results_list) + 1]] <- data.frame(
      n = p_n, rho = p_rho, K = p_K, gamma = p_gamma, HetType = p_het, Sim = sim, 
      EmptyCells = d_out$empty_cells, 
      HOMALS = m_out$taus["HOMALS"], GRM = m_out$taus["GRM"], VAMOS = m_out$taus["VAMOS"]
    )
    
    if (is_top20_cond) {
      idx_homals <- order(m_out$scores$HOMALS, decreasing = TRUE, na.last = TRUE)[1:20]
      idx_grm    <- order(m_out$scores$GRM,    decreasing = TRUE, na.last = TRUE)[1:20]
      idx_vamos  <- order(m_out$scores$VAMOS,  decreasing = TRUE, na.last = TRUE)[1:20]
      
      top20_results_list[[sim]] <- data.frame(
        Sim = sim, Estimated_Rank = 1:20,
        HOMALS = d_out$mu[idx_homals], GRM = d_out$mu[idx_grm], VAMOS = d_out$mu[idx_vamos]
      )
    }
  }
}

all_results <- bind_rows(results_list)
top20_df <- bind_rows(top20_results_list)


# ==============================================================================
# 4. 시각화 (Visualization)
